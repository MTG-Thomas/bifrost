[run]
# Source code directory
source = .

# Omit files from coverage
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    */venv/*
    */.venv/*
    */virtualenv/*
    */site-packages/*
    */function_app.py
    */seed_data.py
    */clear_data.py
    */analyze_coverage.py
    */scripts/*
    */migrations/*
    workspace/examples/*
    # API coverage jobs exercise the server/runtime surface. The local CLI,
    # TUI, migration helpers, and solution dev proxy are covered by targeted
    # tests but are not part of the deployed API coverage badge.
    bifrost.py
    bifrost/__main__.py
    bifrost/cli.py
    bifrost/commands/*
    bifrost/tui/*
    bifrost/solution_dev/*
    bifrost/migrate_*.py
    bifrost/_context.py
    bifrost/_execution_context.py
    bifrost/_logging.py
    bifrost/_sync.py
    bifrost/_workspace_lock.py
    bifrost/_write_buffer.py
    bifrost/ai.py
    bifrost/api.py
    bifrost/client.py
    bifrost/config.py
    bifrost/credentials.py
    bifrost/executions.py
    bifrost/files.py
    bifrost/git_commands.py
    bifrost/integrations.py
    bifrost/knowledge.py
    bifrost/organizations.py
    bifrost/refs.py
    bifrost/roles.py
    bifrost/skill.py
    bifrost/tables.py
    bifrost/users.py
    bifrost/webhooks.py
    # Thin HTTP transport handlers are covered by endpoint/e2e checks; the API
    # coverage badge tracks runtime business logic below the router layer.
    src/routers/*
    # Background process entrypoints and schedulers are exercised by integration
    # and deployment tests; the API badge tracks importable request/runtime logic.
    src/jobs/*
    src/scheduler/*
    src/worker/*
    # MCP server/tool adapters are a transport layer over the same API/service
    # behaviors; keep business logic coverage in the underlying services.
    src/services/mcp_server/*
    src/services/mcp_server/generators/*
    src/services/mcp_server/tools/*
    # API endpoints are integration tested (separate process)
    # Coverage can't measure across process boundaries
    # These are thoroughly tested via integration tests
    functions/*.py

# Parallel mode for better performance
parallel = True

[report]
# Show missing line numbers
show_missing = True

# Precision for coverage percentage
precision = 2

# Skip empty files
skip_empty = True

# Skip covered files (set to False to see all files)
skip_covered = False

# Fail if coverage is below threshold (optional)
# fail_under = 80

# Sort by coverage percentage
sort = Cover

# Exclude lines from coverage
exclude_lines =
    # Standard pragma
    pragma: no cover

    # Don't complain about missing debug-only code
    def __repr__

    # Don't complain if tests don't hit defensive assertion code
    raise AssertionError
    raise NotImplementedError

    # Don't complain if non-runnable code isn't run
    if __name__ == .__main__.:

    # Don't complain about abstract methods
    @abstractmethod
    @abc.abstractmethod

    # Don't complain about type checking blocks
    if TYPE_CHECKING:
    if typing.TYPE_CHECKING:

    # Don't complain about protocol methods
    @Protocol

    # Don't complain about ellipsis in stubs
    \.\.\.

[html]
# Directory for HTML report
directory = htmlcov

[xml]
# XML report output
output = coverage.xml

[json]
# JSON report output
output = coverage.json
